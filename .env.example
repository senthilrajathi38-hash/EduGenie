APP_NAME=FitBuddy
ENVIRONMENT=development
DATABASE_URL=sqlite:///./fitbuddy.db

# Google Gemini
GEMINI_API_KEY=
WORKOUT_MODEL=gemini-3.1-pro-preview
NUTRITION_MODEL=gemini-3.8-flash

# If true, the app works without Gemini and returns deterministic demo content.
DEMO_MODE=false

# Admin dashboard/API credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Application limits
MAX_FEEDBACK_LENGTH=2000
